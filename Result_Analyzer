def analyze_result(name, roll, marks):

    total = sum(marks)
    average = total / len(marks)

    # Grade Calculation
    if average >= 90:
        grade = "A"
    elif average >= 75:
        grade = "B"
    elif average >= 60:
        grade = "C"
    elif average >= 40:
        grade = "D"
    else:
        grade = "Fail"

    print("Student:", name, "(Roll:", roll, ")")
    print("Total:", total)
    print("Average:", average)
    print("Grade:", grade)

    print("Subjects below 40:")

    found = False


    for i in range(len(marks)):
        if marks[i] < 40:
            print("Subject", i + 1)
            found = True

    if not found:
        print("None")

        
